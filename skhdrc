# skhd config - shortcut daemon

# Move focus
ctrl - h : yabai -m window --focus west
ctrl - l : yabai -m window --focus east
ctrl - k : yabai -m window --focus north
ctrl - j : yabai -m window --focus south

# Swap windows
shift + ctrl - h : yabai -m window --swap west
shift + ctrl - l : yabai -m window --swap east
shift + ctrl - k : yabai -m window --swap north
shift + ctrl - j : yabai -m window --swap south

# Resize windows (ctrl + alt preserved)
ctrl + alt - h : yabai -m window --resize left:-30:0
ctrl + alt - l : yabai -m window --resize right:30:0
ctrl + alt - k : yabai -m window --resize top:0:-30
ctrl + alt - j : yabai -m window --resize bottom:0:30

# Rotate layouts
ctrl - r : yabai -m space --rotate 90

# Mirror layout
ctrl - m : yabai -m space --mirror vertical

# Launch apps
ctrl - return : open -a "iTerm"
ctrl - s : open -a "Brave Browser"
ctrl + shift - f : open -a "Finder"
ctrl - d: open -a "Obsidian"
ctrl - e: open -a "Spotify"

# Move to spaces
ctrl + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
ctrl + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
ctrl + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
ctrl + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
# ... add more if needed

# float toggle
ctrl - t : yabai -m window --toggle float
ctrl - F : yabai -m window --toggle zoom-fullscreen

ctrl + shift - t : \
    current_layout=$(yabai -m query --spaces --space | jq -r '.type'); \
    if [ "$current_layout" = "bsp" ]; then \
        yabai -m space --layout stack; \
    else \
        yabai -m space --layout bsp; \
    fi

ctrl + shift - r : yabai --restart-service

ctrl - 1 : /bin/bash -c "sleep 0.15; yabai -m space --focus 1"
ctrl - 2 : /bin/bash -c "sleep 0.15; yabai -m space --focus 2"
ctrl - 3 : /bin/bash -c "sleep 0.15; yabai -m space --focus 3"
