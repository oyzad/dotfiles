# basic settings 
set hidden true
set ignorecase true
set icons true

# Custom Functions
cmd mkdir ${{
  printf "Directory Name: "
  read ans
  mkdir $ans
}}

cmd mkfile ${{
  printf "File Name: "
  read ans
  $EDITOR $ans
}}
cmd open &{{
	case $(file --mime-type -Lb $f) in
		text/*) lf -remote "send $id \$nvim \$fx";;
		*) xdg-open "$f"
	esac
}}

cmd delete ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "delete?[y/N]"
	read ans
	[ $ans = "y" ] && rm -rf -- $fx
}}

# keybinds
map m 
map d 
map . set hidden!
map md mkdir 
map x cut 
map y copy 
map mf mkfile
map R reload
map <enter> open
map D delete


# movement

map gc cd ~/.config
map gD cd ~/Documents
map gd cd ~/Downloads
map gm cd ~/Documents/Downloads/Music
map gp cd ~/Documents/Projects

